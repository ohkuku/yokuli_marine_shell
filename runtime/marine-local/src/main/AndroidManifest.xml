<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application>
        <receiver android:name="com.yokuli.runtime.marine.chart.store.OfficialChartDownloadReceiver" android:exported="true" android:permission="android.permission.SEND_DOWNLOAD_COMPLETED_INTENTS">
            <intent-filter><action android:name="android.intent.action.DOWNLOAD_COMPLETE" /></intent-filter>
        </receiver>
        <service android:name="com.yokuli.runtime.marine.chart.store.OfficialChartVerificationJob" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
        <service android:name="com.yokuli.runtime.marine.ipc.MarineCoreBinderService"
            android:exported="false" android:stopWithTask="false" />
        <receiver android:name="com.yokuli.runtime.marine.notification.NoticeDismissReceiver" android:exported="false" />
        <receiver android:name="com.yokuli.runtime.marine.notification.RuntimeRecoveryNoticeReceiver" android:exported="false" />
        <service android:name="com.yokuli.runtime.marine.navigation.NavigationTrackingService" android:exported="false" android:stopWithTask="false" android:foregroundServiceType="connectedDevice|location" />
        <service android:name="com.yokuli.runtime.marine.notification.NotificationBinderService"
            android:process=":notifications" android:exported="false" android:stopWithTask="false" />
        <service android:name="com.yokuli.runtime.marine.ais.AisMonitoringService"
            android:exported="false" android:stopWithTask="false" android:foregroundServiceType="connectedDevice|location" />
        <receiver android:name="com.yokuli.runtime.marine.ais.AisRestoreReceiver" android:enabled="true" android:exported="true">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter>
        </receiver>
    </application>
</manifest>
